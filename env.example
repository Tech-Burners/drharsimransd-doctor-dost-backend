# ---------------------------------------------------------------
# DoctorDost backend - environment variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------

# --- Server -----------------------------------------------------
NODE_ENV=development            # development | production
PORT=5000                       # HTTP API port
IP=0.0.0.0                      # interface the HTTP / socket servers bind to
SOCKET_PORT=9020                # Socket.IO port (defaults to 9020 if unset)
PROJECT_NAME=DoctorDost         # shown on the server home page
API_PUBLIC_URL=http://localhost:5000   # used for webhook registration and email links
CORS_ORIGINS=http://localhost:3000     # comma separated. Admin dashboard, local tooling

# --- Database ---------------------------------------------------
# Must be a replica set / Atlas cluster. Every money write runs in a transaction,
# and transactions do not work against a standalone mongod.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctordost
MONGO_MAX_POOL_SIZE=20          # set explicitly. The driver default of 100 per process
                                # exhausts a small Atlas tier once you run 2 API instances
                                # plus a worker

# --- Redis ------------------------------------------------------
# BullMQ queues, login rate limiting, doctor presence keys, Socket.IO adapter.
# The adapter is required from day one, not when you add a second instance: without it a
# doctor connected to instance A never receives an event emitted from instance B.
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=                 # leave blank locally

# --- Auth / security --------------------------------------------
BCRYPT_SALT_ROUNDS=12           # used for passwords and hashed OTPs
JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string
JWT_ACCESS_EXPIRES_IN=15m       # short on purpose. Revocation before expiry is handled by
                                # User.tokenVersion, which only works if the window is small
JWT_REFRESH_EXPIRES_IN=30d      # rotated on every use, reuse of a spent token revokes all

# --- OTP --------------------------------------------------------
OTP_EXPIRE_TIME=5               # minutes until an OTP expires
                                # SMS delivery in Tripura can take 30-60s, so 2 minutes
                                # leaves the doctor about a minute to type it
OTP_TOKEN_EXPIRE_TIME=5m        # lifetime of the signup / forgot-password token
OTP_MAX_ATTEMPTS=5              # verification attempts before the code is burned

# --- Default admin (created on first start) ---------------------
# Rotate ADMIN_PASSWORD after the first successful login. This value sits in your
# deployment config forever otherwise.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_PHONE=+910000000000

# --- Razorpay (patient wallet top-ups) --------------------------
# The webhook is the ONLY path that credits a wallet. App success screens never do.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me      # HMAC verification. NOT the same as the key secret

# --- Agora (voice) ----------------------------------------------
AGORA_APP_ID=xxxxxxxx
AGORA_APP_CERTIFICATE=change-me        # mints call tokens. Anyone holding it can spend your
                                       # Agora minutes. Treat it like a payment key
AGORA_WEBHOOK_SECRET=change-me         # verifies call events. A forged event with duration 0
                                       # is a free consultation
AGORA_TOKEN_GRACE_SECONDS=60           # token expiry set this far past maxAffordableSeconds
AGORA_CUSTOMER_ID=                     # REST API basic auth, for closing a channel server side
AGORA_CUSTOMER_SECRET=

# --- Push notifications (FCM via firebase-admin) ----------------
# The only remaining Firebase dependency. It carries no data, only identifiers.
FIREBASE_PROJECT_ID=doctordost
FIREBASE_SERVICE_ACCOUNT_BASE64=       # base64 of the service account JSON, single line

# --- SMS (doctor phone verification) ----------------------------
# Provider not yet chosen. Names below assume MSG91; rename to match whatever you pick.
# India requires a registered DLT template for transactional SMS, so SMS_TEMPLATE_ID is
# not optional once you go live.
SMS_PROVIDER=msg91
SMS_API_KEY=change-me
SMS_SENDER_ID=DRDOST
SMS_TEMPLATE_ID=

# --- Object storage (S3 compatible) -----------------------------
# Certificates, signature images, prescription PDFs, call recordings.
# Every object is private. Reads go through a short lived signed URL, never a public link.
# Defaults assume AWS S3 in Mumbai. For R2 or Spaces, change S3_ENDPOINT and S3_REGION.
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=doctordost
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_SIGNED_URL_TTL_SECONDS=900          # 15 minutes

# --- Email (SMTP via nodemailer) --------------------------------
NODEMAILER_HOST_EMAIL=your-sender@gmail.com
NODEMAILER_HOST_PASS=your-app-password   # app password, not the account password
CONTACT_EMAIL=support@example.com        # receives Contact Us messages
LOGO_URL=https://example.com/logo.png    # logo shown in emails
ALERT_EMAIL=ops@example.com              # receives reconciliation findings. A findings
                                         # collection nobody opens is theatre

# --- Monitoring -------------------------------------------------
SENTRY_DSN=                     # blank disables Sentry. Set in both API and worker

# --- Operational tuning -----------------------------------------
# Business rules live in the PlatformSetting document, not here. These are operational
# values that have nothing to do with pricing.
PRESENCE_TTL_SECONDS=90         # three missed heartbeats before a doctor counts as offline
PRESENCE_SWEEP_SECONDS=60       # how often the worker clears stale Doctor.isOnline
CALL_COOLDOWN_SECONDS=45        # minimum gap between call attempts by one patient
CALL_ORPHAN_GRACE_SECONDS=300   # past maxAffordableSeconds before the sweep closes a call
                                # whose Agora end event never arrived

# --- Server home page monitor login -----------------------------
# NOTE: these are rendered into the home page's client-side script by
# serverHomePage.ts, so treat them as low-security. Never reuse a real credential here,
# and consider disabling the page entirely in production.
MONITOR_USERNAME=monitor
MONITOR_PASSWORD=change-me
